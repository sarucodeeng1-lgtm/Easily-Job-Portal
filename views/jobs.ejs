<%- include('partials/header', { title }) %>
<section class="page-hero compact-hero"><span class="eyebrow">FIND YOUR NEXT CHAPTER</span><h1>Work that works <span>for you.</span></h1><p>Explore open roles and find the place where you can do your best work.</p><form class="hero-search jobs-search" action="/jobs" method="GET"><span class="search-icon">⌕</span><input name="q" value="<%= query %>" aria-label="Search jobs" placeholder="Job title, skill, or company"><button class="button button-primary" type="submit">Search <span>→</span></button></form></section>
<section class="listing-section"><div class="listing-top"><div><h2>Open opportunities</h2><p><%= total %> role<%= total === 1 ? '' : 's' %> to explore<%= query ? ` for “${query}”` : '' %></p></div><span class="result-pill">Page <%= page %> of <%= totalPages %></span></div>
<% if (!jobs.length) { %><div class="empty-state"><div class="empty-icon">⌕</div><h3>No matching jobs yet</h3><p>Try another search, or check back soon for new opportunities.</p><a class="button button-outline" href="/jobs">Clear search</a></div><% } else { %><div class="job-grid"><% jobs.forEach((job, index) => { %><article class="job-card"><div class="job-card-top"><div class="company-mark mark-<%= index % 4 %>"><%= job.company.slice(0,1).toUpperCase() %></div><span class="job-type"><%= job.employmentType %></span></div><h3><a href="/jobs/<%= job.id %>"><%= job.title %></a></h3><p class="job-company"><%= job.company %></p><div class="job-meta"><span>⌖ <%= job.location %></span><span>◷ <%= job.salary %></span></div><% if (job.skills) { %><div class="skill-tags"><% job.skills.split(',').slice(0,3).forEach(skill => { %><span><%= skill.trim() %></span><% }) %></div><% } %><div class="job-card-footer"><span>Posted <%= job.createdAt.toLocaleDateString() %></span><a href="/jobs/<%= job.id %>">View role <span>→</span></a></div></article><% }) %></div>
<% if (totalPages > 1) { %><nav class="pagination" aria-label="Job listing pages"><% if (page > 1) { %><a href="/jobs?q=<%= encodeURIComponent(query) %>&page=<%= page - 1 %>">← Previous</a><% } %><% for (let p = 1; p <= totalPages; p++) { %><a class="page-number <%= p === page ? 'active' : '' %>" href="/jobs?q=<%= encodeURIComponent(query) %>&page=<%= p %>"><%= p %></a><% } %><% if (page < totalPages) { %><a href="/jobs?q=<%= encodeURIComponent(query) %>&page=<%= page + 1 %>">Next →</a><% } %></nav><% } %><% } %></section>
<%- include('partials/footer') %>
