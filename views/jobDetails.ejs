<%- include('partials/header', { title }) %>
<section class="detail-layout"><a class="back-link" href="/jobs">← Back to opportunities</a><div class="detail-main"><article class="detail-card"><div class="detail-company-row"><div class="company-mark mark-1"><%= job.company.slice(0,1).toUpperCase() %></div><div><span class="eyebrow"><%= job.company %></span><h1><%= job.title %></h1></div></div><div class="detail-meta"><span>⌖ <%= job.location %></span><span>◷ <%= job.employmentType %></span><span>＄ <%= job.salary %></span></div><hr><h2>About the role</h2><p class="job-description"><%= job.description %></p><h2>Skills & experience</h2><div class="skill-tags"><% (job.skills || 'Open to learning').split(',').forEach(skill => { %><span><%= skill.trim() %></span><% }) %></div><div class="posted-note">Posted on <%= job.createdAt.toLocaleDateString() %></div></article></div><aside class="apply-sidebar"><span class="eyebrow">YOUR NEXT STEP</span><h2>Does this sound like you?</h2><p>Take the next step and let the team know you're interested.</p><% if (currentUser && currentUser.role === 'jobseeker') { %><a class="button button-primary button-full" href="/jobs/<%= job.id %>/apply">Apply for this job <span>→</span></a><% } else if (!currentUser) { %><a class="button button-primary button-full" href="/login">Log in to apply <span>→</span></a><p class="sidebar-note">You'll need a job seeker account to apply.</p><% } else { %><p class="sidebar-note">You're logged in as a recruiter. Browse jobs to see opportunities.</p><% } %><div class="sidebar-stat"><span>Applications</span><b><%= applicationCount %></b></div></aside></section>
<%- include('partials/footer') %>
