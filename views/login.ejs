<%- include('partials/header', { title }) %>
<section class="auth-layout"><div class="auth-aside"><span class="eyebrow">WELCOME BACK</span><h1>There's more<br><span>ahead.</span></h1><p>Your next opportunity could be one click away. Pick up right where you left off.</p><div class="aside-note"><span>↗</span><div><b>Your journey continues</b><small>Good to have you back at Easily.</small></div></div></div><div class="auth-card"><div class="auth-card-heading"><span class="eyebrow">YOUR SPACE AWAITS</span><h2>Log in to Easily</h2><p>Enter your details to continue.</p></div>
<% if (error) { %><div class="form-error"><%= error %></div><% } %>
<form action="/login" method="POST" class="form-stack"><label>Email address<input type="email" name="email" value="<%= email || '' %>" placeholder="you@example.com" required autocomplete="email"></label><label>Password<input type="password" name="password" placeholder="Your password" required autocomplete="current-password"></label><button class="button button-primary button-full" type="submit">Log in <span>→</span></button></form><p class="auth-switch">New to Easily? <a href="/register">Create an account</a></p></div></section>
<%- include('partials/footer') %>
