<%- include('partials/header', { title }) %>
<section class="dashboard-page"><div class="dashboard-heading"><div><span class="eyebrow">RECRUITER WORKSPACE</span><h1>Your hiring <span>dashboard.</span></h1><p>Manage your open roles and meet your next great teammate.</p></div><a class="button button-primary" href="/jobs/new">＋ Post a job</a></div><div class="dashboard-stats"><div><span>Active postings</span><b><%= jobs.length %></b></div><div><span>Total applicants</span><b><%= jobs.reduce((sum, job) => sum + job.applicationCount, 0) %></b></div><div><span>Account type</span><b>Recruiter</b></div></div><div class="listing-top"><div><h2>Your job postings</h2><p>Keep your opportunities up to date.</p></div></div><% if (!jobs.length) { %><div class="empty-state"><div class="empty-icon">＋</div><h3>Your first hire starts here</h3><p>Post a role to start meeting talented candidates.</p><a class="button button-primary" href="/jobs/new">Create your first job</a></div><% } else { %><div class="dashboard-job-list"><% jobs.forEach(job => { %><article class="dashboard-job"><div class="company-mark mark-2"><%= job.company.slice(0,1).toUpperCase() %></div><div class="dashboard-job-info"><h3><a href="/jobs/<%= job.id %>"><%= job.title %></a></h3><p><%= job.company %> · <%= job.location %></p><span class="applicant-count"><%= job.applicationCount %> applicant<%= job.applicationCount === 1 ? '' : 's' %></span></div><div class="dashboard-actions"><a class="button button-outline button-small" href="/jobs/<%= job.id %>/edit">Edit</a><a class="button button-outline button-small" href="/jobs/<%= job.id %>/applicants">Applicants</a><form action="/jobs/<%= job.id %>/delete" method="POST" onsubmit="return confirm('Delete this job posting?')"><button class="button button-danger button-small" type="submit">Delete</button></form></div></article><% }) %></div><% } %></section>
<%- include('partials/footer') %>
