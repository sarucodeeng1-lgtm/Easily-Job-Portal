<%- include('partials/header', { title }) %>
<section class="auth-layout"><div class="auth-aside"><span class="eyebrow">MAKE YOUR NEXT MOVE</span><h1>Good things<br>start <span>here.</span></h1><p>One account. New possibilities. Build the future you want with Easily.</p><div class="aside-note"><span>✦</span><div><b>Built around you</b><small>Opportunities for every ambition.</small></div></div></div><div class="auth-card"><div class="auth-card-heading"><span class="eyebrow">JOIN EASILY</span><h2>Create your account</h2><p>Get started — it only takes a minute.</p></div>
<% if (error) { %><div class="form-error"><%= error %></div><% } %>
<form action="/register" method="POST" class="form-stack"><label>Full name<input type="text" name="name" value="<%= values.name || '' %>" placeholder="Your name" required minlength="2" autocomplete="name"></label><label>Email address<input type="email" name="email" value="<%= values.email || '' %>" placeholder="you@example.com" required autocomplete="email"></label><label>Password<input type="password" name="password" placeholder="At least 8 characters" required minlength="8" autocomplete="new-password"></label><label>I am joining as<select name="role" required><option value="">Choose your role</option><option value="jobseeker" <%= values.role === 'jobseeker' ? 'selected' : '' %>>Job seeker — I'm looking for work</option><option value="recruiter" <%= values.role === 'recruiter' ? 'selected' : '' %>>Recruiter — I'm hiring</option></select></label><button class="button button-primary button-full" type="submit">Create account <span>→</span></button></form><p class="auth-switch">Already have an account? <a href="/login">Log in</a></p></div></section>
<%- include('partials/footer') %>
