<%- include('partials/header', { title }) %>
<section class="form-page apply-page"><a class="back-link" href="/jobs/<%= job.id %>">← Back to job details</a><div class="form-page-heading"><span class="eyebrow">MAKE YOUR MOVE</span><h1>Apply for <span><%= job.title %>.</span></h1><p><%= job.company %> · <%= job.location %></p></div><div class="form-panel"><% if (error) { %><div class="form-error"><%= error %></div><% } %><div class="application-intro"><div class="company-mark mark-0"><%= job.company.slice(0,1).toUpperCase() %></div><div><b><%= job.title %></b><span><%= job.company %></span></div></div><form action="/jobs/<%= job.id %>/apply" method="POST" enctype="multipart/form-data" class="form-stack"><label>Resume / CV *<input type="file" name="resume" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required><small>PDF, DOC or DOCX · Maximum 5 MB</small></label><div class="upload-tip"><span>↥</span><p>Upload a recent resume so the recruiter can learn about your experience and skills.</p></div><button class="button button-primary button-full" type="submit">Submit application <span>→</span></button></form><p class="privacy-note">Your resume is kept private and is only available through the application's protected download route.</p></div></section>
<%- include('partials/footer') %>
