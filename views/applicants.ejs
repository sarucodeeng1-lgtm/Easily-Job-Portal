<%- include('partials/header', { title }) %>
<section class="dashboard-page"><a class="back-link" href="/dashboard">← Back to dashboard</a><div class="dashboard-heading"><div><span class="eyebrow">CANDIDATE PIPELINE</span><h1>Applicants for <span><%= job.title %>.</span></h1><p><%= job.company %> · <%= applications.length %> application<%= applications.length === 1 ? '' : 's' %></p></div></div><% if (!applications.length) { %><div class="empty-state"><h3>No applications yet</h3><p>Applications will appear here when candidates apply.</p></div><% } else { %><div class="applicant-list"><% applications.forEach(application => { %><article class="applicant-card"><div class="applicant-avatar"><%= application.applicantName.slice(0,1).toUpperCase() %></div><div class="applicant-info"><h3><%= application.applicantName %></h3><p><%= application.applicantEmail %></p><small>Applied <%= application.appliedAt.toLocaleDateString() %></small><div><a class="text-link" href="/applications/<%= application.id %>/resume">Download resume ↗</a></div></div><div class="applicant-controls"><span class="status-pill status-<%= application.status.toLowerCase() %>"><%= application.status %></span><form action="/jobs/<%= job.id %>/applicants/<%= application.id %>/status" method="POST"><label class="sr-only" for="status-<%= application.id %>">Application status</label><select id="status-<%= application.id %>" name="status"><% ['Pending','Reviewed','Shortlisted','Rejected'].forEach(status => { %><option <%= application.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="button button-outline button-small" type="submit">Update</button></form></div></article><% }) %></div><% } %></section>
<%- include('partials/footer') %>
