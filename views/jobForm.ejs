<%- include('partials/header', { title }) %>
<section class="form-page"><a class="back-link" href="/dashboard">← Back to dashboard</a><div class="form-page-heading"><span class="eyebrow">HELP GREAT PEOPLE FIND YOU</span><h1><%= heading %></h1><p>Share the details candidates need to picture themselves on your team.</p></div><div class="form-panel"><% if (error) { %><div class="form-error"><%= error %></div><% } %><form action="<%= action %>" method="POST" class="form-stack two-column-form"><label class="wide-field">Job title *<input name="title" value="<%= job.title || '' %>" placeholder="e.g. Frontend Developer" required maxlength="120"></label><label>Company *<input name="company" value="<%= job.company || '' %>" placeholder="Company name" required maxlength="120"></label><label>Location *<input name="location" value="<%= job.location || '' %>" placeholder="e.g. Remote / New Delhi" required></label><label>Employment type<select name="employmentType"><% ['Full-time','Part-time','Contract','Internship','Remote'].forEach(type => { %><option value="<%= type %>" <%= (job.employmentType || 'Full-time') === type ? 'selected' : '' %>><%= type %></option><% }) %></select></label><label>Salary / compensation<input name="salary" value="<%= job.salary || '' %>" placeholder="e.g. ₹6–9 LPA or Competitive"></label><label class="wide-field">Skills (comma separated)<input name="skills" value="<%= job.skills || '' %>" placeholder="JavaScript, React, teamwork"></label><label class="wide-field">Job description *<textarea name="description" rows="7" required maxlength="5000" placeholder="Describe the role, responsibilities, and what makes your team special..."><%= job.description || '' %></textarea></label><div class="wide-field form-actions"><button class="button button-primary" type="submit"><%= job.id ? 'Save changes' : 'Publish job' %> <span>→</span></button><a class="button button-outline" href="/dashboard">Cancel</a></div></form></div></section>
<%- include('partials/footer') %>
